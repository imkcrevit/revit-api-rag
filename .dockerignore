# Git
.git
.gitignore
.github

# Python
__pycache__
*.pyc
*.pyo
*.egg-info
.venv
venv
frontend/dist/

# IDE
.vscode
.idea
*.swp

# Runtime data is mounted into the container, not copied into the image.
data/sqlite/
data/chromadb/
data/legacy_db/

# Data archives (use extracted dirs only)
data/chromadb_api.tar.gz
data/chromadb_code.tar.gz

# Legacy
legacy/

# Pipeline training data (not needed at runtime)
data/raw/
data/knowledge/
pipeline/parser/
pipeline/cleaner/

# Notebooks
*.ipynb
.ipynb_checkpoints

# Docs
*.md
!config/*.md
!prompts/*.md
!data/skills/*.md

# Frontend build artifacts (rebuilt in stage 1)
frontend/node_modules
frontend/dist

# Large data / non-runtime dirs (keep build context small)
data/legacy_db/
h/
scratch/
images/
tests/

# Misc
.env
.secrets/
.claude/
