<Page x:Class="revit_mcp_plugin.UI.ConnectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:revit_mcp_plugin.UI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Connection Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Configure how the plugin connects to the MCP server"
                       Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Settings Form -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <!-- Connection Mode -->
            <TextBlock Text="Connection Mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="TcpRadio" Content="TCP (Local Server)"
                             GroupName="Mode" IsChecked="True" Margin="0,0,30,0"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="WsRadio" Content="WebSocket (Cloud)"
                             GroupName="Mode"
                             Checked="Mode_Changed"/>
            </StackPanel>

            <!-- TCP Settings -->
            <Border x:Name="TcpPanel" Padding="15" Background="#f9f9f9"
                    BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="TCP Settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Grid.Column="1" Text="18080"
                                 Width="100" HorizontalAlignment="Left" Padding="5,3"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- WebSocket Settings -->
            <Border x:Name="WsPanel" Padding="15" Background="#f9f9f9"
                    BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="WebSocket Settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server URL:" VerticalAlignment="Center"/>
                        <TextBox x:Name="WsUrlTextBox" Grid.Column="1"
                                 Text="wss://graptolite.ai/api/v1/bridge/ws" Padding="5,3"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Slot ID:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SlotComboBox" Width="80" HorizontalAlignment="Left">
                            <ComboBoxItem Content="1" IsSelected="True"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Padding="10" Background="#f0f8ff" BorderBrush="#b0d4f1"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Current Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText" Text="Not connected" Foreground="#666"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Height="30" Background="#0078D7" Foreground="White"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
